# Copie para server/.env e preencha. Nunca commite o .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Banco local do docker-compose.yml (só desenvolvimento).
DATABASE_URL=postgres://forgeon:forgeon_dev@localhost:5432/forgeon_clinic

# 32 bytes aleatórios em base64. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Token da equipe Forgeon para o auditor de uso (GET /admin/usage). Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FORGEON_ADMIN_TOKEN=

# Meta for Developers > app Forgeon Clinic.
# App secret: Configurações do app > Básico > Chave secreta do aplicativo.
WHATSAPP_APP_SECRET=
# Texto livre que você inventa e repete ao cadastrar o webhook no painel da Meta.
WHATSAPP_VERIFY_TOKEN=
# Token de acesso (temporário de 24 h no teste; depois, token do usuário do sistema).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0

# Responde "Eco: ..." a cada texto recebido. Só funciona com NODE_ENV=development.
WHATSAPP_DEV_ECHO=true
