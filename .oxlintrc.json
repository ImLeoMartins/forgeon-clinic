  "overrides": [
    {
      "files": [
        "design-system/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "scripts/**",
        "vite.config.ts"
      ],
      "rules": {
        "ds/no-restricted-syntax": "off"
      }
    }
