        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:pt-BR|es-ES)$/]",
        "message": "<ChatBubble> locale must be one of 'pt-BR' | 'es-ES'."
