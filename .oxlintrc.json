{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "import",
    "typescript"
  ],
  "jsPlugins": [
    "./scripts/oxlint-ds-plugin.mjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "design-system/reference/**",
    "design-system/templates/email/**"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "**/design-system/components/**",
              "**/design-system/templates/*/**",
              "@ds/components/**",
              "@ds/templates/*/**"
            ],
            "message": "Import design-system components from '@ds' (design-system/index.ts) and templates from '@ds/templates', not internals."
          }
        ]
      }
    ],
    "ds/no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|endTime|date|patient|service|professional|room|status|locale|bookedByAgent|viaWhatsApp|actions|compact|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AppointmentCard> doesn't accept that prop. Declared props: time, endTime, date, patient, service, professional, room, status, locale, bookedByAgent, viaWhatsApp, actions, compact, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:confirmed|pending|cancelled|noshow|rescheduled)$/]",
        "message": "<AppointmentCard> status must be one of 'confirmed' | 'pending' | 'cancelled' | 'noshow' | 'rescheduled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentCard'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:pt-BR|es-ES)$/]",
        "message": "<AppointmentCard> locale must be one of 'pt-BR' | 'es-ES'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|tone|status|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, tone, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|away|offline)$/]",
        "message": "<Avatar> status must be one of 'online' | 'away' | 'offline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|dot|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, size, dot, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|teal|success|warning|danger|ai|brand|whatsapp|solid)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'teal' | 'success' | 'warning' | 'danger' | 'ai' | 'brand' | 'whatsapp' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|fullWidth|disabled|loading|type|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, fullWidth, disabled, loading, type, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|soft|ghost|danger|whatsapp)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'soft' | 'ghost' | 'danger' | 'whatsapp'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|title|subtitle|actions|footer|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, title, subtitle, actions, footer, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outlined|elevated|flat|selected)$/]",
        "message": "<Card> variant must be one of 'outlined' | 'elevated' | 'flat' | 'selected'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|text|time|status|author|locale|children|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: from, text, time, status, author, locale, children, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:patient|agent|human|system)$/]",
        "message": "<ChatBubble> from must be one of 'patient' | 'agent' | 'human' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:sent|delivered|read)$/]",
        "message": "<ChatBubble> status must be one of 'sent' | 'delivered' | 'read'."
      },
