        "message": "<HandoffAlert> doesn't accept that prop. Declared props: urgency, title, reason, quote, patient, waiting, locale, onAccept, onView, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandoffAlert'] > JSXAttribute[name.name='urgency'] > Literal[value!=/^(?:normal|urgent)$/]",
        "message": "<HandoffAlert> urgency must be one of 'normal' | 'urgent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HandoffAlert'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:pt-BR|es-ES)$/]",
        "message": "<HandoffAlert> locale must be one of 'pt-BR' | 'es-ES'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title, style."
