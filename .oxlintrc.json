        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|iconLeft|suffix|size|id|required|disabled|value|defaultValue|placeholder|type|onChange|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, iconLeft, suffix, size, id, required, disabled, value, defaultValue, placeholder, type, onChange, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|delta|hint|icon|tone|sparkline|style|key|ref|className|style|children)$/]",
        "message": "<KpiCard> doesn't accept that prop. Declared props: label, value, unit, delta, hint, icon, tone, sparkline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|ai)$/]",
        "message": "<KpiCard> tone must be one of 'default' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|label|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, tone, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|endorsed|symbol|forgeon)$/]",
        "message": "<Logo> variant must be one of 'lockup' | 'endorsed' | 'symbol' | 'forgeon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:color|ink|white)$/]",
        "message": "<Logo> tone must be one of 'color' | 'ink' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PatientTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|locale|onRowClick|selectedId|emptyLabel|style|key|ref|className|style|children)$/]",
        "message": "<PatientTable> doesn't accept that prop. Declared props: rows, locale, onRowClick, selectedId, emptyLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PatientTable'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:pt-BR|es-ES)$/]",
        "message": "<PatientTable> locale must be one of 'pt-BR' | 'es-ES'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|checked|defaultChecked|onChange|disabled|name|value|id|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, description, checked, defaultChecked, onChange, disabled, name, value, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|options|placeholder|size|iconLeft|id|required|disabled|value|defaultValue|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, hint, error, options, placeholder, size, iconLeft, id, required, disabled, value, defaultValue, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Select> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|locale|label|size|key|ref|className|style|children)$/]",
        "message": "<StatusBadge> doesn't accept that prop. Declared props: status, locale, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:confirmed|pending|cancelled|noshow|rescheduled)$/]",
        "message": "<StatusBadge> status must be one of 'confirmed' | 'pending' | 'cancelled' | 'noshow' | 'rescheduled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBadge'] > JSXAttribute[name.name='locale'] > Literal[value!=/^(?:pt-BR|es-ES)$/]",
        "message": "<StatusBadge> locale must be one of 'pt-BR' | 'es-ES'."
      },
