        "message": "<Switch> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, label, description, disabled, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|variant|size|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, onChange, variant, size, style."
      },
